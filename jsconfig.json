{
    "compilerOptions": {
        "module": "esnext",
        "types": [
            "node"
        ],
        "checkJs": true,
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "skipLibCheck": true,
        "noEmit": true,
    },
    "include": [
        "**/*.js",
        "**/*.ts",
        "**/*.d.ts",
        "global.d.ts"
    ],
    "exclude": [
        "website",
        "dist",
        "ai_update",
        "node_modules",
        "**/node_modules",

        "analyze_circular.js",
        "error_reader.js",
        "*test*.*js",
    ]
}