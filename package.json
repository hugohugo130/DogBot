  "scripts": {
    "start": "node .",
    "test": "node ./test.cjs",
    "check-deps": "node check_circular_dependencies.js",
    "pretest": "npm run check-deps",
    "changelog": "powershell -Command '$changeLogFolderPath = \"./changelog\"; if (-not Test-Path -Path $changeLogFolderPath) {New-Item -Path $directoryPath -ItemType Directory ^| Out-Null}; auto-changelog --output $changeLogFolderPath/$(Get-Date -Format \"yyyyMMdd_HHmmss\") --template keepachangelog'"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@snazzah/davey": "^0.1.12",
    "axios": "^1.20.0",
    "diff": "^9.0.0",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "mediaplex": "^1.0.0",
    "opusscript": "^0.1.1",
    "pg": "^8.23.0",
    "pgsql-parser": "^18.2.8",
    "prism-media": "^1.3.5",
    "soundcloud.ts": "^0.7.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.11.0",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-jsdoc": "^64.5.4",
