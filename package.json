  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node .",
    "test": "node ./test.js",
    "check-deps": "node check_circular_dependencies.js",
    "pretest": "npm run check-deps",
    "changelog": "powershell -Command '$changeLogFolderPath = \"./changelogs\"; if (-not Test-Path -Path $changeLogFolderPath) {New-Item -Path $directoryPath -ItemType Directory ^| Out-Null}; auto-changelog --output $changeLogFolderPath/$(Get-Date -Format \"yyyyMMdd_HHmmss\") --template keepachangelog'"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@snazzah/davey": "^0.1.12",
    "axios": "^1.18.1",
    "diff": "^8.0.4",
    "discord.js": "^14.26.4",
    "express": "^5.2.1",
    "file-type": "^21.3.4",
    "fluent-ffmpeg": "^2.1.3",
    "mediaplex": "^1.0.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "soundcloud.ts": "^0.7.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jscodeshift": "^17.3.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  }
}
