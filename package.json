    "jscodeshift": "^17.4.0",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  }
}
